.mypy_cache/
.ruff_cache/

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 本地配置（绝不入库）────────────────────────────────
.credentials*
*.token
*.secret
